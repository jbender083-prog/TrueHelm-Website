{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "*.py"
    ],
    "headers": [
      {
        "source": "/downloads/TrueHelm_Launcher_Windows.zip",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"TrueHelm_Launcher_Windows.zip\""
          }
        ]
      },
      {
        "source": "/downloads/TrueHelmLauncher.exe",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"TrueHelmLauncher.exe\""
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
